# ---------- Server ----------
PORT=5000
NODE_ENV=development

# Public URL of THIS API (used in the Integrations page for webhook URLs)
PUBLIC_API_URL=

# URL of the website (used in password-reset emails).
WEB_APP_URL=http://localhost:5173

# CORS is open: any website or app can call this API (no origin list needed).

# Business timezone ("today", dashboard charts, reminder texts). IANA name.
TIMEZONE=Asia/Kolkata

# ---------- Database ----------
MONGODB_URI=mongodb://127.0.0.1:27017/harbour_crm

# ---------- Security ----------
# Long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=30d

# ---------- Uploads ----------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25

# ---------- Push reminders (Expo) ----------
# Every 5 minutes the server pushes follow-ups due in the next N minutes.
REMINDER_WINDOW_MINUTES=15

# ---------- Facebook Lead Ads (optional) ----------
# Your Meta app secret; when set, webhook signatures are verified.
META_APP_SECRET=

# ---------- Email for password reset (optional) ----------
# If SMTP is not configured, reset links are printed in the server log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Harbour CRM <no-reply@yourdomain.com>"
